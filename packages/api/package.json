{
  "name": "@world-cup-2026-predictor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx ./src/db-migrate.ts",
    "audit:live-prediction-evidence": "tsx ./src/live-prediction-evidence-gate-cli.ts",
    "audit:prediction-usefulness": "node --experimental-strip-types ./src/prediction-usefulness-audit-cli.ts",
    "capture:prematch-snapshots": "tsx ./src/prematch-snapshot-capture-cli.ts",
    "evaluate:completed-predictions": "tsx ./src/completed-prediction-evaluation-cli.ts",
    "statsbomb:download": "tsx ./src/statsbomb-open-data-downloader.ts",
    "statsbomb:build-profiles": "tsx ./src/statsbomb-open-data-cli.ts",
    "statsbomb:backtest": "tsx ./src/statsbomb-backtesting-cli.ts",
    "historical-elo:validate": "tsx ./src/historical-elo-replay-cli.ts",
    "historical-data:validate": "tsx ./src/historical-international-data-cli.ts",
    "goal-model:compare": "tsx ./src/attack-defense-goal-model-cli.ts",
    "goal-model:recalibrate": "tsx ./src/attack-defense-goal-model-recalibration-cli.ts",
    "attack-defense:eligibility": "tsx ./src/scripts/list-attack-defense-runtime-eligibility.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
