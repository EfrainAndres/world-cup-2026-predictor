{
  "name": "@world-cup-2026-predictor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx ./src/db-migrate.ts",
    "audit:live-prediction-evidence": "node --experimental-strip-types ./src/live-prediction-evidence-gate-cli.ts",
    "audit:prediction-usefulness": "node --experimental-strip-types ./src/prediction-usefulness-audit-cli.ts",
    "capture:prematch-snapshots": "tsx ./src/prematch-snapshot-capture-cli.ts",
    "evaluate:completed-predictions": "tsx ./src/completed-prediction-evaluation-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
