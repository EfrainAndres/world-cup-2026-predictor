{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "FOOTBALL_DATA_API_TOKEN",
        "PERSISTENCE_PROVIDER",
        "RESULTS_PROVIDER",
        "FOOTBALL_DATA_COMPETITION_CODE",
        "FOOTBALL_DATA_SEASON"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
