# Results provider mode
# Accepted values: "local" (default) | "football_data_org"
# Set to "football_data_org" to enable live synchronization from football-data.org API v4.
# Leave as "local" to use the deterministic local static provider (no network calls).
RESULTS_PROVIDER=local

# football-data.org API credentials
# Required only when RESULTS_PROVIDER=football_data_org.
# Never use a NEXT_PUBLIC_ prefix — this token must remain server-only.
# Obtain a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=your_token_here

# Competition code for football-data.org v4 API
# Default: WC (FIFA World Cup)
FOOTBALL_DATA_COMPETITION_CODE=WC

# Season year for football-data.org v4 API
# Default: 2026
FOOTBALL_DATA_SEASON=2026

# Prediction history persistence
# Accepted values: "memory" (default) | "postgres"
# Leave as "memory" for deterministic local development and tests.
PERSISTENCE_PROVIDER=memory

# PostgreSQL connection string for server-side prediction history persistence.
# Required only when PERSISTENCE_PROVIDER=postgres.
# Never use a NEXT_PUBLIC_ prefix and never commit real credentials.
DATABASE_URL=postgresql://user:password@localhost:5432/world_cup_2026_predictor

# PostgreSQL connection string for integration tests.
# MUST be a separate database from DATABASE_URL — never set to the same value.
# Required only to run the 28 PostgreSQL contract tests in packages/api.
# When absent, those tests skip automatically without failing the suite.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/world_cup_2026_predictor_test

# Automated pre-match snapshot capture (Phase 12.18A1)
# Capture writes immutable pre-match snapshots for upcoming fixtures before
# kickoff. Non-dry-run capture requires PERSISTENCE_PROVIDER=postgres and a
# DATABASE_URL (above); it never falls back to memory silently.

# Run capture without writing any snapshot ("true" | "false", default false).
PREMATCH_CAPTURE_DRY_RUN=false

# Optional ISO timestamp used as "now" for non-production testing only.
# Rejected in non-dry postgres mode unless PREMATCH_CAPTURE_ALLOW_TIME_OVERRIDE=true.
PREMATCH_CAPTURE_NOW=

# Gate that permits PREMATCH_CAPTURE_NOW in postgres capture mode ("true" | "false").
PREMATCH_CAPTURE_ALLOW_TIME_OVERRIDE=false

# Optional comma-separated allow-list of official fixture ids to capture.
PREMATCH_CAPTURE_FIXTURE_IDS=

# Capture execution mode (Phase 12.18A2)
# Accepted values: "preflight" | "dry_run" | "capture" (default: "capture")
# preflight: validates config and connectivity; no predictions, no writes.
# dry_run:   discovers eligible fixtures; no persistence writes.
# capture:   performs the protected capture flow (requires postgres).
PREMATCH_CAPTURE_MODE=capture
